WrapSpacerWidgetClass dropdownPrefab {
 clipchildren 0
 ignorepointer 1
 position 0 0
 size 1 1
 halign center_ref
 hexactpos 0
 vexactpos 0
 hexactsize 0
 vexactsize 0
 priority 999
 scriptclass "DropdownBinding"
 Padding 0
 Margin 0
 "Size To Content V" 1
 {
  FrameWidgetClass dropdownFrame {
   ignorepointer 1
   size 1 1
   halign center_ref
   valign center_ref
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   priority 999
   {
    PanelWidgetClass dropdownOutline {
     disabled 0
     ignorepointer 1
     color 0.9961 0.9961 0.9961 1
     position 0 0
     size 1 1
     halign right_ref
     valign center_ref
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     style WB_Panel_Variant2
     {
      ButtonWidgetClass dropdownToggle {
       disabled 0
       clipchildren 1
       inheritalpha 0
       ignorepointer 0
       color 0.9961 0.9882 0.9843 0.0118
       position 0 0
       size 1 1
       halign right_ref
       valign center_ref
       hexactpos 0
       vexactpos 0
       hexactsize 0
       vexactsize 0
       style Requirement_Card
       switch toggle
       {
        TextWidgetClass dropdownValue {
         clipchildren 1
         ignorepointer 1
         size 0.82 1
         valign center_ref
         hexactpos 0
         vexactpos 0
         hexactsize 0
         vexactsize 0
         scaled 1
         text "Select..."
         style Normal
         font "gui/fonts/etelkatextpro16"
         "text offset" 10 0
         "exact text" 1
         "size to text h" 0
         "size to text v" 0
         "text valign" center
        }
        FrameWidgetClass dropdownIconFrame {
         clipchildren 0
         inheritalpha 0
         ignorepointer 1
         position 0 0
         size 0.8 1
         halign right_ref
         valign center_ref
         hexactpos 0
         vexactpos 0
         hexactsize 0
         vexactsize 0
         fixaspect inside
         {
          ImageWidgetClass dropdownExpandIcon {
           visible 1
           clipchildren 1
           inheritalpha 1
           ignorepointer 1
           position 0 0
           size 10 10
           halign center_ref
           valign center_ref
           hexactpos 0
           vexactpos 1
           hexactsize 1
           vexactsize 1
           image0 "set:ccgui_enforce image:CrScrollV"
           mode blend
           "src alpha" 1
           "stretch mode" stretch_w_h
           "flip v" 1
           filter 1
          }
         }
        }
       }
      }
     }
    }
    ButtonWidgetClass dropdownReset {
     visible 0
     color 0.6863 0.2863 0.2863 1
     position 0.0628 0
     size 0.06 0.9
     halign right_ref
     valign center_ref
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     style Requirement_Card
     text "x"
     font "gui/fonts/etelkatextpro22"
    }
   }
  }
  WrapSpacerWidgetClass dropdownContent {
   visible 0
   ignorepointer 1
   color 0.1137 0.1137 0.1137 1
   position 0 0
   size 1 118.824
   halign center_ref
   hexactpos 1
   vexactpos 1
   hexactsize 0
   vexactsize 1
   priority 999
   style Empty
   "Ignore invisible" 0
   Padding 0
   Margin 0
   {
    FrameWidgetClass dropdownContentFrame {
     visible 1
     ignorepointer 1
     position 0 0
     size 1 1
     valign center_ref
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     priority 999
     {
      ScrollWidgetClass dropdownScroll {
       visible 1
       clipchildren 1
       ignorepointer 1
       color 0 0 0 1
       position 0 0
       size 1 1
       halign right_ref
       valign center_ref
       hexactpos 0
       vexactpos 0
       hexactsize 0
       vexactsize 0
       priority 999
       style blank
       "Scrollbar V" 1
       {
        WrapSpacerWidgetClass dropdownItemsContainer {
         clipchildren 1
         ignorepointer 1
         position 0 0
         size 1 0
         halign center_ref
         hexactpos 0
         vexactpos 0
         hexactsize 0
         vexactsize 0
         priority 999
         "Size To Content H" 1
         "Size To Content V" 1
        }
       }
      }
     }
    }
   }
  }
 }
 {
  ScriptParamsClass {
   Binding_Items "{{ _dropdownItems }}"
   Binding_Value "{{ _dropdownValue }}"
   Binding_Placeholder "Select..."
   OnChange "OnDropdownChanged"
  }
 }
}
