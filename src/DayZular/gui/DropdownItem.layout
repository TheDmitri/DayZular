ButtonWidgetClass dropdownItemRoot {
 position 0 0
 size 1 40
 halign center_ref
 hexactpos 0
 vexactpos 0
 hexactsize 0
 vexactsize 1
 style Default
 {
  TextWidgetClass dropdownItemLabel {
   ignorepointer 1
   position 0 0
   size 1 1
   halign center_ref
   valign center_ref
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   text ""
   font "gui/fonts/etelkatextpro16"
   "exact text" 1
   "text offset" 10 0
   "text valign" center
  }
 }
}
